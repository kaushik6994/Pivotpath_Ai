# Copy this file to .env; never commit .env.
# scripts/start.py and the VS Code debugger load .env. Direct uvicorn does not.

# Local demonstration: fictional records and one-click persona switching.
ATLAS_DEMO_MODE=1

# For a fresh non-demo workspace, set ATLAS_DEMO_MODE=0 and set these values.
# Use a fresh data directory: an existing demo database cannot become non-demo.
# ATLAS_DATA_DIR=data-private
# ATLAS_ADMIN_EMAIL=you@example.com
# ATLAS_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional full path to the SQLite database (normally managed within DATA_DIR).
# ATLAS_DB_PATH=/absolute/path/to/atlas.sqlite3

# Enable only when serving over HTTPS; HTTP localhost needs this disabled.
# ATLAS_SECURE_COOKIES=1
